{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "rootDir": ".",
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "importHelpers": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": true,
    "paths": {
      "@shelfmark/contracts": ["./libs/shared/contracts/src/index.ts"],
      "@shelfmark/contract-tests": ["./libs/shared/contract-tests/src/index.ts"],
      "@shelfmark/contracts/testing": ["./libs/shared/contracts/src/testing/index.ts"],
      "@shelfmark/ui": ["./libs/ui/src/index.ts"],
      "@shelfmark/ui/testing": ["./libs/ui/src/testing/index.ts"],
      "@shelfmark/web-csp": ["./libs/web/csp/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp", "dist"]
}
