{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npx nx:*)",
      "Bash(nx:*)",
      "Bash(npm ci)",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm ls:*)",
      "Bash(npm view:*)",
      "Bash(npm audit:*)",
      "Bash(npx prettier:*)",
      "Bash(npx eslint:*)",
      "Bash(npx stylelint:*)",
      "Bash(npx vitest:*)",
      "Bash(npx playwright:*)",
      "Bash(npx tsc:*)",
      "Bash(npx lefthook validate)",
      "Bash(npx lefthook install)",
      "Bash(export PATH=$HOME/.nvm/versions/node/*)",
      "Bash(source ~/.nvm/nvm.sh)",
      "Bash(nvm use:*)",
      "Bash(nvm current)",
      "Bash(nvm version:*)",
      "Bash(node --check:*)",
      "Bash(gitleaks version)",
      "Bash(gitleaks git:*)",
      "Bash(curl -s localhost:*)",
      "Bash(curl -si localhost:*)",
      "Bash(curl -i localhost:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -si http://localhost:*)",
      "Bash(curl -i http://localhost:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git rebase:*)",
      "Bash(git stash:*)",
      "Bash(git worktree:*)",
      "Bash(git rev-parse:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh project:*)",
      "Bash(gh label:*)",
      "Bash(gh run:*)",
      "Bash(gh repo view:*)",
      "Bash(gh api:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.preview)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/.envrc)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.preview)",
      "Edit(**/.env.production)",
      "Edit(**/.env.test)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.vercel/**)",
      "Read(~/Library/Application Support/com.vercel.cli/**)",
      "Read(~/.config/neonctl/**)",
      "Bash(gh pr merge:*)",
      "Bash(gh secret:*)",
      "Bash(gh auth token:*)",
      "Bash(vercel env pull:*)",
      "Bash(vercel env ls:*)",
      "Bash(neonctl connection-string:*)",
      "Bash(vercel env:*)",
      "Bash(vercel pull:*)",
      "Bash(npx vercel env:*)",
      "Bash(npx vercel pull:*)",
      "Bash(neonctl cs:*)",
      "Bash(neon connection-string:*)",
      "Bash(neon cs:*)",
      "Read(~/.config/neon/**)",
      "Read(**/.vercel/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-on-edit.mjs\"",
            "timeout": 90,
            "statusMessage": "Formatting and lint-fixing the edited file"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-checks.mjs\"",
            "timeout": 600,
            "statusMessage": "Typecheck and tests for changed projects"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-checks.mjs\"",
            "timeout": 600,
            "statusMessage": "Typecheck and tests for changed projects"
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": ["angular-cli", "nx-mcp", "playwright"]
}
