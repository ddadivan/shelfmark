{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npx nx run-many -t build -p web api --output-style=static",
  "outputDirectory": "dist/apps/web/browser",
  "regions": ["fra1"],
  "git": {
    "deploymentEnabled": {
      "dependabot/**": false
    }
  },
  "functions": {
    "api/index.mjs": {
      "maxDuration": 10,
      "includeFiles": "node_modules/swagger-ui-dist/**"
    }
  },
  "rewrites": [
    { "source": "/zz1/:p*", "destination": "/api" },
    { "source": "/zz6/(.*)", "destination": "/api/health" },
    { "source": "/zz7", "destination": "/api" },
    { "source": "/api/(.*)", "destination": "/api" }
  ],
  "headers": [
    {
      "source": "/((?!api/|api$).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; form-action 'self'"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    },
    {
      "source": "/(.*-[A-Z0-9]{8}\\.(?:js|css))",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/media/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
