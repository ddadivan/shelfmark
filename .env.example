# Names only, never values. Real secrets live in Vercel / GitHub settings.
# Where each value goes: docs/SETUP.md.

# API listen port (optional, default 3000). Keep 3000 locally: the web dev proxy targets it.
PORT

# Database (Neon). Locally `nx serve api` starts an embedded PGlite and sets these itself.
# Pooled connection string, used by the running API.
DATABASE_URL
# Direct (unpooled) connection string, used only by `prisma migrate` in the Vercel build.
DATABASE_URL_UNPOOLED

# Better Auth (ADR 0012, ADR 0026). Set per environment; locally export them in the shell (docs/SETUP.md 4).
# Signing secret, at least 32 characters, one value per environment. Required everywhere.
BETTER_AUTH_SECRET
# Public origin of the app, no path. Required in production and previews (https); locally
# defaults to http://localhost:4200.
BETTER_AUTH_URL
# Optional extra trusted origins, comma-separated, exact origins only (no wildcards).
BETTER_AUTH_TRUSTED_ORIGINS
# OAuth clients. Each provider needs both variables; a provider without them is simply disabled.
GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET
GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET
# Rate limiting (ADR 0031): set to 1 only behind a trusted proxy that overwrites x-forwarded-for
# (never on a directly exposed server). Vercel sets VERCEL=1, which is enough there.
TRUST_PROXY_HEADERS
