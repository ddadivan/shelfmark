{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/web/src",
  "tags": ["scope:web", "type:app"],
  "implicitDependencies": ["ui"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/web",
        "browser": "apps/web/src/main.ts",
        "tsConfig": "apps/web/tsconfig.app.json",
        "polyfills": [],
        "inlineStyleLanguage": "scss",
        "assets": [
          { "glob": "**/*", "input": "apps/web/public" },
          { "glob": "**/*", "input": "libs/ui/src/assets", "output": "assets/ui" }
        ],
        "styles": [
          "node_modules/@fontsource-variable/onest/wght.css",
          "libs/ui/src/styles/global.scss",
          "apps/web/src/styles.scss"
        ],
        "stylePreprocessorOptions": { "includePaths": ["libs/ui/src/styles"] },
        "optimization": {
          "scripts": true,
          "styles": { "minify": true, "inlineCritical": false },
          "fonts": false
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            { "type": "initial", "maximumWarning": "500kb", "maximumError": "1mb" },
            { "type": "anyComponentStyle", "maximumWarning": "4kb", "maximumError": "8kb" }
          ],
          "outputHashing": "all"
        },
        "development": {
          "fileReplacements": [
            {
              "replace": "apps/web/src/app/core/auth/provide-auth-api.ts",
              "with": "apps/web/src/app/core/auth/provide-auth-api.dev.ts"
            }
          ],
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        },
        "e2e": {
          "budgets": [
            { "type": "initial", "maximumWarning": "500kb", "maximumError": "1mb" },
            { "type": "anyComponentStyle", "maximumWarning": "4kb", "maximumError": "8kb" }
          ],
          "outputHashing": "all",
          "outputPath": "dist/apps/web-e2e-build",
          "fileReplacements": [
            {
              "replace": "apps/web/src/app/app.routes.ts",
              "with": "apps/web/src/app/app.routes.e2e.ts"
            },
            {
              "replace": "apps/web/src/app/core/auth/provide-auth-api.ts",
              "with": "apps/web/src/app/core/auth/provide-auth-api.dev.ts"
            }
          ]
        }
      }
    },
    "middleware-shell": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "inputs": ["{workspaceRoot}/scripts/write-middleware-shell.mjs", "production", "^production"],
      "outputs": ["{workspaceRoot}/dist/apps/web/middleware"],
      "cache": true,
      "options": {
        "command": "node scripts/write-middleware-shell.mjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "check-bundle": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "inputs": [
        "{workspaceRoot}/scripts/check-production-bundle.mjs",
        "production",
        "^production"
      ],
      "cache": true,
      "options": {
        "command": "node scripts/check-production-bundle.mjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "proxyConfig": "apps/web/proxy.conf.json"
      },
      "configurations": {
        "production": { "buildTarget": "web:build:production" },
        "development": { "buildTarget": "web:build:development" }
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "web:build",
        "port": 4200,
        "staticFilePath": "dist/apps/web/browser",
        "spa": true
      },
      "configurations": {
        "e2e": {
          "buildTarget": "web:build:e2e",
          "staticFilePath": "dist/apps/web-e2e-build/browser"
        }
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "tsConfig": "apps/web/tsconfig.spec.json",
        "buildTarget": "web:build:development",
        "runner": "vitest",
        "watch": false
      },
      "configurations": {
        "coverage": { "coverage": true }
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "ngc -p apps/web/tsconfig.app.json --noEmit",
          "ngc -p apps/web/tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    }
  }
}
