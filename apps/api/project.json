{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "tags": ["scope:api", "type:app"],
  "implicitDependencies": ["contracts"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/api"],
      "options": {
        "command": "webpack-cli build --config webpack.config.js --mode production",
        "cwd": "apps/api"
      },
      "configurations": {
        "development": {
          "command": "webpack-cli build --config webpack.config.js --mode development"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["build"],
      "options": {
        "commands": [
          "webpack-cli build --watch --config webpack.config.js --mode development",
          "node --watch ../../dist/apps/api/main.js"
        ],
        "cwd": "apps/api",
        "env": { "NODE_ENV": "development" },
        "parallel": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc --noEmit -p apps/api/tsconfig.app.json",
          "tsc --noEmit -p apps/api/tsconfig.spec.json"
        ],
        "parallel": false
      }
    }
  }
}
