{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "tags": ["scope:api", "type:app"],
  "implicitDependencies": ["contracts"],
  "targets": {
    "prisma-generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/prisma/schema.prisma",
        "{projectRoot}/prisma.config.ts",
        { "externalDependencies": ["prisma", "@prisma/client"] }
      ],
      "outputs": ["{projectRoot}/src/generated/prisma"],
      "options": {
        "command": "prisma generate",
        "cwd": "apps/api",
        "env": { "CHECKPOINT_DISABLE": "1", "PRISMA_HIDE_UPDATE_MESSAGE": "1" }
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build", "prisma-generate"],
      "outputs": ["{workspaceRoot}/dist/apps/api"],
      "options": {
        "command": "webpack-cli build --config webpack.config.js --mode production",
        "cwd": "apps/api"
      },
      "configurations": {
        "development": {
          "command": "webpack-cli build --config webpack.config.js --mode development"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["build"],
      "options": {
        "commands": [
          "webpack-cli build --watch --config webpack.config.js --mode development",
          "node scripts/local-db.mjs -- node --watch ../../dist/apps/api/main.mjs"
        ],
        "cwd": "apps/api",
        "env": { "NODE_ENV": "development" },
        "parallel": true
      }
    },
    "db-migrate": {
      "executor": "nx:run-commands",
      "dependsOn": ["prisma-generate"],
      "options": {
        "command": "node scripts/local-db.mjs --shadow -- prisma migrate dev",
        "cwd": "apps/api",
        "env": { "CHECKPOINT_DISABLE": "1", "PRISMA_HIDE_UPDATE_MESSAGE": "1" }
      }
    },
    "db-check": {
      "executor": "nx:run-commands",
      "dependsOn": ["prisma-generate"],
      "options": {
        "command": "node scripts/local-db.mjs --memory -- node scripts/db-check.mjs",
        "cwd": "apps/api"
      }
    },
    "migrate-deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node scripts/migrate-deploy.mjs",
        "cwd": "apps/api"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "dependsOn": ["^typecheck", "prisma-generate"],
      "options": {
        "commands": [
          "tsc --noEmit -p apps/api/tsconfig.app.json",
          "tsc --noEmit -p apps/api/tsconfig.spec.json"
        ],
        "parallel": false
      }
    },
    "lint": {
      "dependsOn": ["prisma-generate"]
    },
    "test": {
      "dependsOn": ["prisma-generate"]
    }
  }
}
