// Data model for the API. Conventions (ADR 0025):
// - PascalCase models mapped to snake_case plural tables, camelCase fields mapped to snake_case columns.
// - Ids are UUID v7 generated by Prisma, timestamps are timestamptz(3).
// - Applied migrations are never edited; schema changes follow expand-then-contract.
// - Better Auth (#64) must be configured to match: `advanced.database.generateId: false` (so the
//   uuid(7) default below applies) and `user.additionalFields.isDemo` with `input: false`.
// The connection URL lives in prisma.config.ts, not here.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  runtime             = "nodejs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// Better Auth core models (users, sessions, linked OAuth accounts, verification tokens).

model User {
  id                    String    @id @default(uuid(7)) @db.Uuid
  name                  String
  email                 String    @unique
  emailVerified         Boolean   @default(false) @map("email_verified")
  image                 String?
  isDemo                Boolean   @default(false) @map("is_demo")
  onboardingCompletedAt DateTime? @map("onboarding_completed_at") @db.Timestamptz(3)
  demoExpiresAt         DateTime? @map("demo_expires_at") @db.Timestamptz(3)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions              Session[]
  accounts              Account[]
  folders               Folder[]
  links                 Link[]
  tags                  Tag[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

// Library models (PROJECT.md 6.1). Every row belongs to a user; the service layer filters by userId.
// Same-user integrity: Folder.parent uses a composite FK (parentId, userId) -> (id, userId), so a
// folder tree never crosses users. Link.folder, LinkTag.link and LinkTag.tag stay single-column FKs:
// Link.folderId needs `ON DELETE SET NULL (folder_id)`, which Prisma cannot generate, and LinkTag has
// no userId (PROJECT.md 6.1). Plain-SQL CHECKs and the case-insensitive tag index live in the migration.
//
// The service layer (#72) must enforce:
// - ownership of folderId, parentId and every link/tag id through a `userId` filter, with cross-user
//   404 tests (never 403);
// - no folder cycles on move (walk the ancestors of the new parent);
// - title truncated to LINK_LIMIT.TitleMax when the preview fails and the URL is used as title;
// - faviconUrl and imageUrl set server-side only (from the preview), never from client input.

model Folder {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Folder?  @relation("FolderTree", fields: [parentId, userId], references: [id, userId], onDelete: Cascade)
  children  Folder[] @relation("FolderTree")
  links     Link[]

  @@unique([id, userId])
  @@index([userId, parentId])
  @@index([parentId])
  @@map("folders")
}

model Link {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  folderId         String?   @map("folder_id") @db.Uuid
  url              String    @db.VarChar(2048)
  normalizedUrl    String    @map("normalized_url") @db.VarChar(2048)
  title            String    @db.VarChar(300)
  // lower(title), kept in sync by the service: the keyset cursor sorts on it (ADR 0033).
  titleSortKey     String    @map("title_sort_key")
  note             String?
  faviconUrl       String?   @map("favicon_url") @db.VarChar(2048)
  imageUrl         String?   @map("image_url") @db.VarChar(2048)
  // Source URLs as sent by the client or found in the preview; never fetched here. faviconUrl and
  // imageUrl stay null until the image capture of #149 (ADR 0027).
  faviconSourceUrl String?   @map("favicon_source_url") @db.VarChar(2048)
  imageSourceUrl   String?   @map("image_source_url") @db.VarChar(2048)
  // Client-generated UUID that makes a retried create return the first link (ADR 0033).
  idempotencyKey   String?   @map("idempotency_key") @db.Uuid
  isFavorite       Boolean   @default(false) @map("is_favorite")
  lastOpenedAt     DateTime? @map("last_opened_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder           Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  tags             LinkTag[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([userId, normalizedUrl])
  @@index([userId, lastOpenedAt])
  @@index([userId, titleSortKey, id])
  @@index([folderId])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "links_title_trgm_idx")
  @@index([note(ops: raw("gin_trgm_ops"))], type: Gin, map: "links_note_trgm_idx")
  @@index([url(ops: raw("gin_trgm_ops"))], type: Gin, map: "links_url_trgm_idx")
  @@map("links")
}

model Tag {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  name      String    @db.VarChar(50)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  links     LinkTag[]

  @@unique([userId, name])
  @@map("tags")
}

model LinkTag {
  linkId String @map("link_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid
  link   Link   @relation(fields: [linkId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([linkId, tagId])
  @@index([tagId])
  @@map("link_tags")
}
