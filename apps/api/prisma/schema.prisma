// Data model for the API. Conventions (ADR 0025):
// - PascalCase models mapped to snake_case plural tables, camelCase fields mapped to snake_case columns.
// - Ids are UUID v7 generated by Prisma, timestamps are timestamptz(3).
// - Applied migrations are never edited; schema changes follow expand-then-contract.
// - Better Auth (#64) must be configured to match: `advanced.database.generateId: false` (so the
//   uuid(7) default below applies) and `user.additionalFields.isDemo` with `input: false`.
// The connection URL lives in prisma.config.ts, not here.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  runtime             = "nodejs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// Better Auth core models (users, sessions, linked OAuth accounts, verification tokens).

model User {
  id                    String    @id @default(uuid(7)) @db.Uuid
  name                  String
  email                 String    @unique
  emailVerified         Boolean   @default(false) @map("email_verified")
  image                 String?
  isDemo                Boolean   @default(false) @map("is_demo")
  onboardingCompletedAt DateTime? @map("onboarding_completed_at") @db.Timestamptz(3)
  demoExpiresAt         DateTime? @map("demo_expires_at") @db.Timestamptz(3)
  // HMAC of the creating client IP for the per-IP demo quota (#67); never the raw address.
  demoSourceHash        String?   @map("demo_source_hash")
  // Same for the wider IPv6 /48 network (null for IPv4 clients).
  demoNetworkHash       String?   @map("demo_network_hash")
  // How long deleted links and folders stay in Trash (ADR 0036); a CHECK in the migration keeps it to 7, 30, 90.
  trashRetentionDays    Int       @default(30) @map("trash_retention_days") @db.SmallInt
  // Account setting "Folder colours" (#263): off shows every folder in graphite.
  folderColours         Boolean   @default(true) @map("folder_colours")
  // "Pause history" on Recently opened (#269): while true, opens are not recorded.
  historyPaused         Boolean   @default(false) @map("history_paused")
  // Settings › Appearance (#273): theme, the Custom theme and Animations. CHECKs in the migration
  // keep each to its allow-list (contracts) and the background to the backgrounds of its base.
  theme                 String    @default("system") @map("theme")
  customThemeBase       String    @default("light") @map("custom_theme_base")
  customThemeAccent     String    @default("ocean") @map("custom_theme_accent")
  customThemeBackground String    @default("paper") @map("custom_theme_background")
  customThemeCorners    String    @default("soft") @map("custom_theme_corners")
  motion                String    @default("system") @map("motion")
  // Set by the first write of theme, customTheme or motion; NULL = the appearance was never chosen.
  appearanceSavedAt     DateTime? @map("appearance_saved_at") @db.Timestamptz(3)
  // Settings › Library (#284). CHECKs in the migration keep the three text columns to the contract
  // allow-lists. newLinksFolderId has no relation on purpose (see the migration): the API checks it.
  defaultView           String    @default("cards") @map("default_view")
  defaultSort           String    @default("newest") @map("default_sort")
  openLinksIn           String    @default("new-tab") @map("open_links_in")
  showFolderCounts      Boolean   @default(true) @map("show_folder_counts")
  newLinksFolderId      String?   @map("new_links_folder_id") @db.Uuid
  warnDuplicates        Boolean   @default(true) @map("warn_duplicates")
  fetchPreviews         Boolean   @default(true) @map("fetch_previews")
  keepQuery             Boolean   @default(false) @map("keep_query")
  // Settings › Appearance extras (#285): part of the appearance (appearanceSavedAt). CHECKs in the
  // migration keep the text columns to the contract allow-lists.
  textSize              String    @default("m") @map("text_size")
  font                  String    @default("onest") @map("font")
  density               String    @default("comfortable") @map("density")
  cardPreview           String    @default("large") @map("card_preview")
  cardSite              Boolean   @default(true) @map("card_site")
  cardNotes             Boolean   @default(true) @map("card_notes")
  cardTags              Boolean   @default(true) @map("card_tags")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions              Session[]
  accounts              Account[]
  folders               Folder[]
  links                 Link[]
  linkImages            LinkImage[]
  tags                  Tag[]
  feedback              Feedback[]
  savedViews            SavedView[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

// Library models (PROJECT.md 6.1). Every row belongs to a user; the service layer filters by userId.
// Same-user integrity: Folder.parent uses a composite FK (parentId, userId) -> (id, userId), so a
// folder tree never crosses users. Link.folder, LinkTag.link and LinkTag.tag stay single-column FKs:
// Link.folderId needs `ON DELETE SET NULL (folder_id)`, which Prisma cannot generate, and LinkTag has
// no userId (PROJECT.md 6.1). Plain-SQL CHECKs and the case-insensitive tag index live in the migration.
//
// The service layer (#72) must enforce:
// - ownership of folderId, parentId and every link/tag id through a `userId` filter, with cross-user
//   404 tests (never 403);
// - no folder cycles on move (walk the ancestors of the new parent);
// - title truncated to LINK_LIMIT.TitleMax when the preview fails and the URL is used as title;
// - the image source URLs and captureAttemptedAt are set server-side only, never from client input.

model Folder {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  name      String   @db.VarChar(100)
  // Style (#263, ADR 0037): one of FOLDER_COLOUR / FOLDER_ICON; a CHECK in the migration closes the colour set.
  colour    String   @default("graphite") @db.VarChar(16)
  icon      String   @default("folder") @db.VarChar(24)
  // Place in the user's sidebar pins (ADR 0037); NULL = not pinned. Cleared when the folder goes to Trash.
  pinnedPosition Int? @map("pinned_position") @db.SmallInt
  // Set when the folder is in Trash (ADR 0036): one shared value for the folder and the subtree deleted with it.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Folder?  @relation("FolderTree", fields: [parentId, userId], references: [id, userId], onDelete: Cascade)
  children  Folder[] @relation("FolderTree")
  links     Link[]

  @@unique([id, userId])
  @@index([userId, parentId])
  @@index([parentId])
  @@map("folders")
}

model Link {
  id                 String      @id @default(uuid(7)) @db.Uuid
  userId             String      @map("user_id") @db.Uuid
  folderId           String?     @map("folder_id") @db.Uuid
  url                String      @db.VarChar(2048)
  normalizedUrl      String      @map("normalized_url") @db.VarChar(2048)
  title              String      @db.VarChar(300)
  // lower(title), kept in sync by the service: the keyset cursor sorts on it (ADR 0033).
  titleSortKey       String      @map("title_sort_key")
  note               String?
  // Remote source URLs as sent by the client or found in the preview; the capture fetches them
  // server-side (ADR 0027). The response derives its same-origin image paths from link_images.
  faviconSourceUrl   String?     @map("favicon_source_url") @db.VarChar(2048)
  imageSourceUrl     String?     @map("image_source_url") @db.VarChar(2048)
  // When the last image capture was attempted (create, or the lazy re-capture of ADR 0027). Defaults
  // to the insert time; a PATCH that changes the page sets it to NULL = "capture pending". The
  // lazy path claims it atomically, which is also its cooldown.
  captureAttemptedAt DateTime?   @default(now()) @map("capture_attempted_at") @db.Timestamptz(3)
  // Client-generated UUID that makes a retried create return the first link (ADR 0033).
  idempotencyKey     String?     @map("idempotency_key") @db.Uuid
  isFavorite         Boolean     @default(false) @map("is_favorite")
  // video | article | shopping | other (LINK_KIND, CHECK in the migration): derived at save time from
  // og:type and the host, recomputed on a URL change, changeable by the user (ADR 0038).
  kind               String      @default("other") @db.VarChar(16)
  // Pinned to the top of its folder (#263): the pin time orders pinned links; NULL = not pinned.
  pinnedInFolderAt   DateTime?   @map("pinned_in_folder_at") @db.Timestamptz(3)
  // Place in the user's sidebar pins (ADR 0037); NULL = not pinned. Cleared when the link goes to Trash.
  pinnedPosition     Int?        @map("pinned_position") @db.SmallInt
  lastOpenedAt       DateTime?   @map("last_opened_at") @db.Timestamptz(3)
  // Set when the link is in Trash (ADR 0036). The partial indexes for Trash live in the migration.
  deletedAt          DateTime?   @map("deleted_at") @db.Timestamptz(3)
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder             Folder?     @relation(fields: [folderId], references: [id], onDelete: SetNull)
  tags               LinkTag[]
  images             LinkImage[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt, id])
  @@index([userId, normalizedUrl])
  @@index([userId, lastOpenedAt])
  @@index([userId, titleSortKey, id])
  @@index([folderId])
  @@index([userId, kind])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "links_title_trgm_idx")
  @@index([note(ops: raw("gin_trgm_ops"))], type: Gin, map: "links_note_trgm_idx")
  @@index([url(ops: raw("gin_trgm_ops"))], type: Gin, map: "links_url_trgm_idx")
  @@map("links")
}

// Re-encoded copy of a link's favicon or preview image (ADR 0027): WebP, at most 64 KB. Served
// same-origin by /api/links/:id/favicon|image, always filtered by userId.
model LinkImage {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  linkId      String   @map("link_id") @db.Uuid
  // 'favicon' | 'preview' (LINK_IMAGE_KIND); a CHECK in the migration keeps it closed.
  kind        String   @db.VarChar(16)
  contentType String   @map("content_type") @db.VarChar(64)
  bytes       Bytes
  width       Int
  height      Int
  sha256      String   @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  link        Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, kind])
  @@index([userId])
  @@map("link_images")
}

model Tag {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  name      String    @db.VarChar(50)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  links     LinkTag[]

  @@unique([userId, name])
  @@map("tags")
}

model LinkTag {
  linkId String @map("link_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid
  link   Link   @relation(fields: [linkId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([linkId, tagId])
  @@index([tagId])
  @@map("link_tags")
}

// Feedback (#100, #272), two kinds of row in one table. A rating (story 24) has a `milestone`
// ("day3", "week1", "month1", "year1"), one row per user and milestone; `score` null records "not now";
// `kind` is null. A message (story 25) has a `kind` ("idea", "problem", "other"), no milestone, no score,
// and `comment` holds the text; `status` ("received", "planned", "in-progress", "done", "not-planned")
// and `reply` are set by the author through the admin API; the optional screenshot (PNG, JPEG or WebP,
// at most 2 MB) lives in `screenshot`. NULL milestones never collide in the unique index. Plain-SQL
// CHECKs (sets, lengths, the rating-or-message shape) live in the migrations. The comment and reply
// are user text: never logged. Reads that do not need the image never select `screenshot`.
model Feedback {
  id               String   @id @default(uuid(7)) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  milestone        String?  @db.VarChar(10)
  score            Int?     @db.SmallInt
  comment          String?
  kind             String?
  status           String   @default("received")
  reply            String?
  screenshot       Bytes?
  screenshotType   String?  @map("screenshot_type")
  clientAppVersion String?  @map("client_app_version") @db.VarChar(300)
  clientUserAgent  String?  @map("client_user_agent") @db.VarChar(300)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, milestone])
  @@index([userId, createdAt])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("feedback")
}

// A saved filter shown as a chip above the feed (#264, ADR 0038). `query` is the normalized
// SavedViewQuery (validated by the API); at most SAVED_VIEW_LIMIT.PerUserMax per user. New users get
// the starter views from a database trigger (see the migration).
model SavedView {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(40)
  query     Json     @db.JsonB
  position  Int      @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, position])
  @@map("saved_views")
}
