// Data model for the API. Conventions (ADR 0025):
// - PascalCase models mapped to snake_case plural tables, camelCase fields mapped to snake_case columns.
// - Ids are UUID v7 generated by Prisma, timestamps are timestamptz(3).
// - Applied migrations are never edited; schema changes follow expand-then-contract.
// - Better Auth (#64) must be configured to match: `advanced.database.generateId: false` (so the
//   uuid(7) default below applies) and `user.additionalFields.isDemo` with `input: false`.
// The connection URL lives in prisma.config.ts, not here.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  runtime             = "nodejs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// Better Auth core models (users, sessions, linked OAuth accounts, verification tokens).

model User {
  id                    String             @id @default(uuid(7)) @db.Uuid
  name                  String
  email                 String             @unique
  emailVerified         Boolean            @default(false) @map("email_verified")
  image                 String?
  isDemo                Boolean            @default(false) @map("is_demo")
  onboardingCompletedAt DateTime?          @map("onboarding_completed_at") @db.Timestamptz(3)
  demoExpiresAt         DateTime?          @map("demo_expires_at") @db.Timestamptz(3)
  // HMAC of the creating client IP for the per-IP demo quota (#67); never the raw address.
  demoSourceHash        String?            @map("demo_source_hash")
  // Same for the wider IPv6 /48 network (null for IPv4 clients).
  demoNetworkHash       String?            @map("demo_network_hash")
  // How long deleted links and folders stay in Trash (ADR 0036); a CHECK in the migration keeps it to 7, 30, 90.
  trashRetentionDays    Int                @default(30) @map("trash_retention_days") @db.SmallInt
  // Account setting "Folder colours" (#263): off shows every folder in graphite.
  folderColours         Boolean            @default(true) @map("folder_colours")
  // "Pause history" on Recently opened (#269): while true, opens are not recorded.
  historyPaused         Boolean            @default(false) @map("history_paused")
  // Settings › Appearance (#273): theme, the Custom theme and Animations. CHECKs in the migration
  // keep each to its allow-list (contracts) and the background to the backgrounds of its base.
  theme                 String             @default("system") @map("theme")
  customThemeBase       String             @default("light") @map("custom_theme_base")
  customThemeAccent     String             @default("ocean") @map("custom_theme_accent")
  customThemeBackground String             @default("paper") @map("custom_theme_background")
  customThemeCorners    String             @default("soft") @map("custom_theme_corners")
  // Own colours (#335): up to 12 lower-case #rrggbb, offered as swatches; a CHECK in the migration keeps the list valid.
  customColours         String[]           @default([]) @map("custom_colours")
  // Own emoji (#363): up to 24 folder emoji the picker offers under "Yours"; the API checks each is one emoji, a CHECK in the migration keeps the count and length.
  customEmoji           String[]           @default([]) @map("custom_emoji")
  motion                String             @default("system") @map("motion")
  // Set by the first write of theme, customTheme or motion; NULL = the appearance was never chosen.
  appearanceSavedAt     DateTime?          @map("appearance_saved_at") @db.Timestamptz(3)
  // Settings › Library (#284). CHECKs in the migration keep the three text columns to the contract
  // allow-lists. newLinksFolderId has no relation on purpose (see the migration): the API checks it.
  defaultView           String             @default("cards") @map("default_view")
  defaultSort           String             @default("newest") @map("default_sort")
  openLinksIn           String             @default("new-tab") @map("open_links_in")
  showFolderCounts      Boolean            @default(true) @map("show_folder_counts")
  newLinksFolderId      String?            @map("new_links_folder_id") @db.Uuid
  // Retired in #315 (the duplicate notice is always on, tracking parameters are always stripped):
  // the API no longer reads or writes warn_duplicates and keep_query; a later migration drops them.
  warnDuplicates        Boolean            @default(true) @map("warn_duplicates")
  fetchPreviews         Boolean            @default(true) @map("fetch_previews")
  keepQuery             Boolean            @default(false) @map("keep_query")
  // Settings › Appearance extras (#285): part of the appearance (appearanceSavedAt). CHECKs in the
  // migration keep the text columns to the contract allow-lists.
  textSize              String             @default("m") @map("text_size")
  font                  String             @default("onest") @map("font")
  density               String             @default("comfortable") @map("density")
  cardPreview           String             @default("large") @map("card_preview")
  cardSite              Boolean            @default(true) @map("card_site")
  cardNotes             Boolean            @default(true) @map("card_notes")
  cardTags              Boolean            @default(true) @map("card_tags")
  // Settings › Language (#274). CHECKs in the migration keep the text columns to the contract
  // allow-lists; languageSavedAt marks the first write (a guest's local choice is kept until then).
  language              String             @default("browser") @map("language")
  dateFormat            String             @default("default") @map("date_format")
  timeFormat            String             @default("default") @map("time_format")
  weekStart             String             @default("default") @map("week_start")
  // Retired in #326 (spell-check in the note field is always on, the browser default): the API no
  // longer reads or writes spellcheck; a later migration drops it.
  spellcheck            Boolean            @default(true) @map("spellcheck")
  languageSavedAt       DateTime?          @map("language_saved_at") @db.Timestamptz(3)
  // Admin usage stats (#333, ADR 0045): UTC day of the last authenticated non-demo request, written
  // at most once a day by UserActivityService; backfilled once in the migration.
  lastActiveOn          DateTime?          @map("last_active_on") @db.Date
  // "What's new" (#424): the newest release (x.y.z) whose highlights the user has seen; NULL until the
  // web app writes it. A CHECK in the migration keeps it to RELEASE_VERSION_PATTERN.
  whatsNewSeen          String?            @map("whats_new_seen")
  // Account plan and AI pack (#389, ADR 0047): stored defaults only. The effective tier also
  // counts AI_FULL_ACCESS_EMAILS, computed per request and never written from the environment.
  // CHECKs in the migration keep plan to free | pro.
  plan                  String             @default("free") @db.VarChar(8)
  aiPack                Boolean            @default(false) @map("ai_pack")
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions              Session[]
  accounts              Account[]
  folders               Folder[]
  links                 Link[]
  linkImages            LinkImage[]
  tags                  Tag[]
  feedback              Feedback[]
  ratingPromptViews     RatingPromptView[]
  folderShares          FolderShare[]
  savedViews            SavedView[]
  linkRules             LinkRule[]
  aiSettings            AiSettings?
  aiUsage               AiUsage[]
  aiJobs                AiJob[]
  aiBatches             AiBatch[]
  linkSuggestions       LinkSuggestion[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

// Library models (PROJECT.md 6.1). Every row belongs to a user; the service layer filters by userId.
// Same-user integrity: Folder.parent uses a composite FK (parentId, userId) -> (id, userId), so a
// folder tree never crosses users. Link.folder, LinkTag.link and LinkTag.tag stay single-column FKs:
// Link.folderId needs `ON DELETE SET NULL (folder_id)`, which Prisma cannot generate, and LinkTag has
// no userId (PROJECT.md 6.1). Plain-SQL CHECKs and the case-insensitive tag index live in the migration.
//
// The service layer (#72) must enforce:
// - ownership of folderId, parentId and every link/tag id through a `userId` filter, with cross-user
//   404 tests (never 403);
// - no folder cycles on move (walk the ancestors of the new parent);
// - title truncated to LINK_LIMIT.TitleMax when the preview fails and the URL is used as title;
// - the image source URLs and captureAttemptedAt are set server-side only, never from client input.

model Folder {
  id             String           @id @default(uuid(7)) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  parentId       String?          @map("parent_id") @db.Uuid
  name           String           @db.VarChar(100)
  // Style (#263, ADR 0037): one of FOLDER_COLOUR / FOLDER_ICON; a CHECK in the migration closes the colour set.
  colour         String           @default("graphite") @db.VarChar(16)
  icon           String           @default("folder") @db.VarChar(24)
  // Shown with a soft background in its colour: sidebar row and page header (#440).
  highlighted    Boolean          @default(false)
  // Optional short description (#418), trimmed, 1 to FOLDER_LIMIT.DescriptionMax characters (a CHECK in the migration).
  description    String?          @db.VarChar(140)
  // The link whose preview image is the cover (#418). No foreign key: the API writes only a live own
  // link of this folder and answers the cover only while that is still true (folder-covers.ts).
  coverLinkId    String?          @map("cover_link_id") @db.Uuid
  // Manual order among the siblings (#314): PUT /api/folders/order; lists sort by it, then by name.
  position       Int              @default(0) @db.SmallInt
  // Place in the user's sidebar pins (ADR 0037); NULL = not pinned. Cleared when the folder goes to Trash.
  pinnedPosition Int?             @map("pinned_position") @db.SmallInt
  // Set when the folder is in Trash (ADR 0036): one shared value for the folder and the subtree deleted with it.
  deletedAt      DateTime?        @map("deleted_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent         Folder?          @relation("FolderTree", fields: [parentId, userId], references: [id, userId], onDelete: Cascade)
  children       Folder[]         @relation("FolderTree")
  links          Link[]
  share          FolderShare?
  linkRules      LinkRule[]
  suggestions    LinkSuggestion[]

  @@unique([id, userId])
  @@index([userId, parentId])
  @@index([parentId])
  @@map("folders")
}

model Link {
  id                 String           @id @default(uuid(7)) @db.Uuid
  userId             String           @map("user_id") @db.Uuid
  folderId           String?          @map("folder_id") @db.Uuid
  url                String           @db.VarChar(2048)
  normalizedUrl      String           @map("normalized_url") @db.VarChar(2048)
  title              String           @db.VarChar(300)
  // lower(title), kept in sync by the service: the keyset cursor sorts on it (ADR 0033).
  titleSortKey       String           @map("title_sort_key")
  note               String?
  // Remote source URLs as sent by the client or found in the preview; the capture fetches them
  // server-side (ADR 0027). The response derives its same-origin image paths from link_images.
  faviconSourceUrl   String?          @map("favicon_source_url") @db.VarChar(2048)
  imageSourceUrl     String?          @map("image_source_url") @db.VarChar(2048)
  // When the last image capture was attempted (create, or the lazy re-capture of ADR 0027). Defaults
  // to the insert time; a PATCH that changes the page sets it to NULL = "capture pending". The
  // lazy path claims it atomically, which is also its cooldown.
  captureAttemptedAt DateTime?        @default(now()) @map("capture_attempted_at") @db.Timestamptz(3)
  // Client-generated UUID that makes a retried create return the first link (ADR 0033).
  idempotencyKey     String?          @map("idempotency_key") @db.Uuid
  isFavorite         Boolean          @default(false) @map("is_favorite")
  // video | article | shopping | other (LINK_KIND, CHECK in the migration): derived at save time from
  // og:type and the host, recomputed on a URL change, changeable by the user (ADR 0038).
  kind               String           @default("other") @db.VarChar(16)
  // Pinned to the top of its folder (#263): the pin time orders pinned links; NULL = not pinned.
  pinnedInFolderAt   DateTime?        @map("pinned_in_folder_at") @db.Timestamptz(3)
  // Place in the user's sidebar pins (ADR 0037); NULL = not pinned. Cleared when the link goes to Trash.
  pinnedPosition     Int?             @map("pinned_position") @db.SmallInt
  lastOpenedAt       DateTime?        @map("last_opened_at") @db.Timestamptz(3)
  // In-app reminder (#275): the link is due once this time has passed; NULL = no reminder. Done
  // clears it. Written with plain SQL so `updated_at` stays; the partial index lives in the migration.
  remindAt           DateTime?        @map("remind_at") @db.Timestamptz(3)
  // AI summary (#391): plain text, at most AI_LIMIT.SummaryMax. `summarySource` is `ai` or `user`
  // (both null or both set, CHECKs in the migration); a `user` summary is never overwritten by AI.
  // `aiStatus` is the latest job status for the cards (pending | done | failed | skipped).
  summary            String?          @db.VarChar(300)
  summarySource      String?          @map("summary_source") @db.VarChar(8)
  aiStatus           String?          @map("ai_status") @db.VarChar(8)
  // Set when the link is in Trash (ADR 0036). The partial indexes for Trash live in the migration.
  deletedAt          DateTime?        @map("deleted_at") @db.Timestamptz(3)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder             Folder?          @relation(fields: [folderId], references: [id], onDelete: SetNull)
  tags               LinkTag[]
  images             LinkImage[]
  aiJobs             AiJob[]
  suggestions        LinkSuggestion[]

  @@unique([id, userId])
  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt, id])
  @@index([userId, normalizedUrl])
  @@index([userId, lastOpenedAt])
  @@index([userId, titleSortKey, id])
  @@index([folderId])
  @@index([userId, kind])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "links_title_trgm_idx")
  @@index([note(ops: raw("gin_trgm_ops"))], type: Gin, map: "links_note_trgm_idx")
  @@index([url(ops: raw("gin_trgm_ops"))], type: Gin, map: "links_url_trgm_idx")
  @@map("links")
}

// Re-encoded copy of a link's favicon or preview image (ADR 0027): WebP, at most 64 KB. Served
// same-origin by /api/links/:id/favicon|image, always filtered by userId.
model LinkImage {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  linkId      String   @map("link_id") @db.Uuid
  // 'favicon' | 'preview' (LINK_IMAGE_KIND); a CHECK in the migration keeps it closed.
  kind        String   @db.VarChar(16)
  contentType String   @map("content_type") @db.VarChar(64)
  bytes       Bytes
  width       Int
  height      Int
  sha256      String   @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  link        Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, kind])
  @@index([userId])
  @@map("link_images")
}

model Tag {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  name      String    @db.VarChar(50)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  links     LinkTag[]

  @@unique([userId, name])
  @@map("tags")
}

model LinkTag {
  linkId String @map("link_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid
  link   Link   @relation(fields: [linkId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([linkId, tagId])
  @@index([tagId])
  @@map("link_tags")
}

// Feedback (#100, #272), two kinds of row in one table. A rating (story 24) has a `milestone`
// ("day3", "week1", "month1", "year1"), one row per user and milestone; `score` null records "not now";
// `kind` is null. A message (story 25) has a `kind` ("idea", "problem", "other"), no milestone, no score,
// and `comment` holds the text; `status` ("received", "planned", "in-progress", "done", "not-planned")
// and `reply` are set by the author through the admin API; up to three screenshots of a message live
// in `FeedbackScreenshot` (#352). NULL milestones never collide in the unique index. Plain-SQL
// CHECKs (sets, lengths, the rating-or-message shape) live in the migrations. The comment and reply
// are user text: never logged.
model Feedback {
  id               String               @id @default(uuid(7)) @db.Uuid
  userId           String               @map("user_id") @db.Uuid
  milestone        String?              @db.VarChar(10)
  score            Int?                 @db.SmallInt
  comment          String?
  kind             String?
  status           String               @default("received")
  reply            String?
  clientAppVersion String?              @map("client_app_version") @db.VarChar(300)
  clientUserAgent  String?              @map("client_user_agent") @db.VarChar(300)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  screenshots      FeedbackScreenshot[]

  @@unique([userId, milestone])
  @@index([userId, createdAt])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("feedback")
}

// How often the rating prompt was shown to a user (#437): one row per user and milestone, written by
// `POST /api/feedback/rating-prompt/views` (an atomic upsert). Read only in the database, through the
// view `admin_user_overview`; no API returns it. The milestone CHECK (same set as feedback) and
// `shown_count > 0` live in the migration.
model RatingPromptView {
  userId       String   @map("user_id") @db.Uuid
  milestone    String   @db.VarChar(10)
  shownCount   Int      @default(1) @map("shown_count")
  firstShownAt DateTime @default(now()) @map("first_shown_at") @db.Timestamptz(3)
  lastShownAt  DateTime @default(now()) @map("last_shown_at") @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, milestone])
  @@map("rating_prompt_views")
}

// A screenshot of a feedback message (#352): at most three per message, `position` 0 to 2 in the
// order they were attached; PNG, JPEG or WebP (`type`), 1 byte to 2 MB. Only message rows get them
// (the API attaches to a message of the session user). Deleting the message (or the user) deletes
// them. Reads that do not need the image never select `bytes`. CHECKs live in the migration.
model FeedbackScreenshot {
  feedbackId String   @map("feedback_id") @db.Uuid
  position   Int      @db.SmallInt
  bytes      Bytes
  type       String
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@id([feedbackId, position])
  @@map("feedback_screenshots")
}

// Public link of a folder (#276, ADR 0040): a row exists exactly while the folder is shared, so
// disabling deletes it and an old token can never come back. `token` is the capability in the
// public URL `/c/{token}`: 16 random bytes as 22 base64url characters, stored as is (the owner can
// copy the link again) behind a unique index, so the public lookup is one indexed equality read.
// The composite FK keeps the share on a folder of the same user; deleting the folder (or the user)
// deletes the share. A CHECK in the migration pins the token format.
model FolderShare {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  folderId       String   @unique @map("folder_id") @db.Uuid
  token          String   @unique @db.VarChar(22)
  showNotes      Boolean  @default(false) @map("show_notes")
  // When the current token was created: enable, or the last reset.
  tokenCreatedAt DateTime @default(now()) @map("token_created_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder         Folder   @relation(fields: [folderId, userId], references: [id, userId], onDelete: Cascade)

  // Required by Prisma for the one-to-one composite relation; folderId alone is already unique.
  @@unique([folderId, userId])
  @@index([userId])
  @@map("folder_shares")
}

// A saved filter shown as a chip above the feed (#264, ADR 0038). `query` is the normalized
// SavedViewQuery (validated by the API); at most SAVED_VIEW_LIMIT.PerUserMax per user. New users get
// the starter views from a database trigger (see the migration).
model SavedView {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(40)
  query     Json     @db.JsonB
  position  Int      @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, position])
  @@map("saved_views")
}

// A domain rule (#398): a link saved from `domain` or one of its subdomains goes to `folderId` and
// gets `tagNames`, unless the save chose them itself. `domain` is `normalizeRuleDomain` (lower case,
// no `www.`, IDN in punycode), unique per user; at most RULE_LIMIT.PerUserMax rules per user.
// `folderId` is a single-column FK with ON DELETE SET NULL like Link.folder (Prisma cannot generate
// `SET NULL (folder_id)` on a composite key); the API checks that the folder is the user's on every
// write and reads it with the userId filter. A folder in Trash keeps the reference (the rule is
// flagged and adds only its tags); deleting it for good clears it. Tags are stored by name, so a
// deleted tag is created again by the next matching save. CHECKs live in the migration.
model LinkRule {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  domain    String   @db.VarChar(253)
  folderId  String?  @map("folder_id") @db.Uuid
  tagNames  String[] @default([]) @map("tag_names")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder    Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@unique([userId, domain])
  @@index([folderId])
  @@map("link_rules")
}

// AI settings (#389, ADR 0047/0048), one row per user; a missing row means the defaults and AI off.
// `enabledAt` is the first time AI was turned on and `introSeenAt` the intro (turning AI on is the
// intro's button). The backfill ("Process existing links") state lives here: a keyset cursor over the
// user's live links created before `enabledAt`, the size of the run, how many links it has done and
// `backfillUsed`, the links ever processed against the one-time allowance (AI_QUOTA.backfillLinks).
// CHECKs in the migration keep the modes and the state to the contract allow-lists.
model AiSettings {
  userId            String    @id @map("user_id") @db.Uuid
  enabled           Boolean   @default(false)
  folderMode        String    @default("suggest") @map("folder_mode") @db.VarChar(8)
  tagsMode          String    @default("suggest") @map("tags_mode") @db.VarChar(8)
  summaries         Boolean   @default(true)
  includeNotes      Boolean   @default(false) @map("include_notes")
  // `app` (the interface language) or a supported interface language code.
  summaryLanguage   String    @default("app") @map("summary_language") @db.VarChar(8)
  enabledAt         DateTime? @map("enabled_at") @db.Timestamptz(3)
  introSeenAt       DateTime? @map("intro_seen_at") @db.Timestamptz(3)
  backfillState     String    @default("idle") @map("backfill_state") @db.VarChar(8)
  backfillCursor    String?   @map("backfill_cursor") @db.Uuid
  backfillTotal     Int       @default(0) @map("backfill_total")
  backfillDone      Int       @default(0) @map("backfill_done")
  backfillUsed      Int       @default(0) @map("backfill_used")
  backfillStartedAt DateTime? @map("backfill_started_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_settings")
}

// Links processed per UTC month (counts only, never content). `month` is the first day of the month.
// Reserved with one INSERT ... ON CONFLICT statement before the model call, refunded on a provider failure.
model AiUsage {
  userId String   @map("user_id") @db.Uuid
  month  DateTime @db.Date
  links  Int      @default(0)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, month])
  @@map("ai_usage")
}

// A provider batch (Message Batches API) of backfill jobs; `providerBatchId` is the provider's id.
model AiBatch {
  id              String    @id @default(uuid(7)) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  provider        String    @db.VarChar(16)
  providerBatchId String    @unique @map("provider_batch_id")
  // submitted | ended | canceled
  status          String    @default("submitted") @db.VarChar(10)
  requestCount    Int       @map("request_count")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  endedAt         DateTime? @map("ended_at") @db.Timestamptz(3)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs            AiJob[]

  @@index([userId, status])
  @@map("ai_batches")
}

// One AI job for a link (or for a draft that is not a link yet). `draftId` is the Add link dialog's
// UUID, unique per user; `linkId` is set when the draft is attached or for save, backfill and rewrite
// jobs (same-user composite FK, cascade). `result` holds the validated model output only while a draft
// is not attached yet and is cleared on attach. `running` is internal and reads as `pending`.
// CHECKs in the migration keep kind, source, status and reason to their sets.
model AiJob {
  id          String           @id @default(uuid(7)) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  linkId      String?          @map("link_id") @db.Uuid
  draftId     String?          @map("draft_id") @db.Uuid
  kind        String           @default("link") @db.VarChar(8)
  // save | draft | backfill | rewrite
  source      String           @db.VarChar(8)
  // pending | running | done | failed | skipped
  status      String           @default("pending") @db.VarChar(8)
  reason      String?          @db.VarChar(16)
  // The parts asked for: any of tags, folder, summary.
  parts       String[]
  language    String           @db.VarChar(8)
  attempts    Int              @default(0) @db.SmallInt
  notBefore   DateTime?        @map("not_before") @db.Timestamptz(3)
  leaseUntil  DateTime?        @map("lease_until") @db.Timestamptz(3)
  batchId     String?          @map("batch_id") @db.Uuid
  result      Json?            @db.JsonB
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  link        Link?            @relation(fields: [linkId, userId], references: [id, userId], onDelete: Cascade)
  batch       AiBatch?         @relation(fields: [batchId], references: [id], onDelete: SetNull)
  suggestions LinkSuggestion[]

  @@unique([userId, draftId])
  @@index([status, notBefore])
  @@index([userId, status])
  @@index([linkId])
  @@index([batchId])
  @@map("ai_jobs")
}

// A tag or folder the model proposed for a link. Dismissed rows stay, so reprocessing never brings
// them back; accepted and dismissed are stored, never sent. Exactly one of `tagName` / `folderId` by
// `kind` (CHECK in the migration). Plain text only.
model LinkSuggestion {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  linkId    String   @map("link_id") @db.Uuid
  jobId     String?  @map("job_id") @db.Uuid
  // tag | new-tag | folder
  kind      String   @db.VarChar(8)
  tagName   String?  @map("tag_name") @db.VarChar(50)
  folderId  String?  @map("folder_id") @db.Uuid
  // suggested | auto-applied | accepted | dismissed
  state     String   @default("suggested") @db.VarChar(12)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  link      Link     @relation(fields: [linkId, userId], references: [id, userId], onDelete: Cascade)
  folder    Folder?  @relation(fields: [folderId, userId], references: [id, userId], onDelete: Cascade)
  job       AiJob?   @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([userId, linkId])
  @@index([jobId])
  @@index([folderId])
  @@map("link_suggestions")
}
