{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Shelfmark",
  "description": "__MSG_extDescription__",
  "version": "1.0.1",
  "default_locale": "en",
  "minimum_chrome_version": "120",
  "homepage_url": "https://shelfmark-app.vercel.app",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S", "mac": "Alt+Shift+S" }
    }
  },
  "permissions": ["activeTab"],
  "host_permissions": ["https://shelfmark-app.vercel.app/api/*"],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://shelfmark-app.vercel.app; connect-src https://shelfmark-app.vercel.app; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  }
}
