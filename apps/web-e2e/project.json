{
  "name": "web-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web-e2e/src",
  "tags": ["scope:web", "type:e2e"],
  "implicitDependencies": ["web"],
  "targets": {
    "lighthouse": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": ["npx nx run web:build:e2e", "node tools/lighthouse/run.mjs"],
        "parallel": false,
        "cwd": "{workspaceRoot}"
      }
    },
    "promo": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx playwright test -c apps/web-e2e/promo/playwright.promo.config.mts",
        "cwd": "{workspaceRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/web-e2e/tsconfig.json --noEmit"
      }
    }
  }
}
