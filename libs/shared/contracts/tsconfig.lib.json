{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // `dom` only for the global `URL` type used by the shared URL helpers (`normalizeUrl`,
    // `isHttpUrl`); `types` stays empty, so no Node or browser globals leak in.
    "lib": ["es2023", "dom"],
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts"]
}
